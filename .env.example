# 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 相机配置
CAMERA_TYPE=hikvision
CAMERA_IP=192.168.1.64
CAMERA_PORT=8000
CAMERA_USERNAME=admin
CAMERA_PASSWORD=admin123
CAMERA_FPS=60
CAMERA_WIDTH=2048
CAMERA_HEIGHT=2048

# PLC配置
PLC_TYPE=modbus_tcp
PLC_HOST=192.168.1.100
PLC_PORT=502
PLC_SLAVE_ID=1
PLC_START_SIGNAL_ADDRESS=0
PLC_STOP_SIGNAL_ADDRESS=1

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=nozzle-videos

# MQTT配置
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=nozzle/inspection

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/nozzle_db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
